+  void ClipperBase::RequireExecutionGateCapacity(
+    ClipperExecutionCounter counter, size_t current, size_t limit,
+    const char* budget)
+  {
+    if (!execution_gate_) return;
+    constexpr size_t RESERVATION_CHUNK = 4096;
+    const size_t index = static_cast<size_t>(counter);
+    if (execution_gate_reservations_[index] > current) return;
+    execution_gate_reservations_[index] += execution_gate_->Reserve(
+      counter, 1, RESERVATION_CHUNK, limit, budget);
+  }
+
+  void ClipperBase::ReleaseExecutionGateReservations()
+  {
+    if (!execution_gate_) return;
+    for (size_t index = 0; index < execution_gate_reservations_.size(); ++index)
+    {
+      const size_t reserved = execution_gate_reservations_[index];
+      if (!reserved) continue;
+      execution_gate_->Release(
+        static_cast<ClipperExecutionCounter>(index), reserved);
+      execution_gate_reservations_[index] = 0;
+    }
+  }
