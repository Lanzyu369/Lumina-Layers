+	class ClipperExecutionLimitError : public std::runtime_error {
+	public:
+		explicit ClipperExecutionLimitError(const char* limit) :
+			std::runtime_error(limit) {}
+	};
+
+	enum class ClipperExecutionCounter : size_t {
+		OutputPoints,
+		OutputRecords,
+		IntersectionNodes,
+		ProcessedIntersections,
+		Count
+	};
+
+	class ClipperExecutionGate {
+	public:
+		size_t Reserve(ClipperExecutionCounter counter, size_t minimum,
+			size_t preferred, size_t limit, const char* budget)
+		{
+			if (exceeded_.load(std::memory_order_acquire))
+				throw ClipperExecutionLimitError(budget);
+			auto& value = counters_[static_cast<size_t>(counter)];
+			size_t current = value.load(std::memory_order_relaxed);
+			while (true)
+			{
+				if (minimum > limit || current > limit - minimum)
+				{
+					exceeded_.store(true, std::memory_order_release);
+					throw ClipperExecutionLimitError(budget);
+				}
+				const size_t reserved = std::min(preferred, limit - current);
+				if (value.compare_exchange_weak(current, current + reserved,
+					std::memory_order_relaxed, std::memory_order_relaxed))
+					return reserved;
+			}
+		}
+
+		void Release(ClipperExecutionCounter counter, size_t count)
+		{
+			if (count)
+				counters_[static_cast<size_t>(counter)].fetch_sub(
+					count, std::memory_order_relaxed);
+		}
+
+		bool Exceeded() const
+		{
+			return exceeded_.load(std::memory_order_acquire);
+		}
+
+	private:
+		std::array<std::atomic<size_t>,
+			static_cast<size_t>(ClipperExecutionCounter::Count)> counters_{};
+		std::atomic<bool> exceeded_{false};
+	};
+
