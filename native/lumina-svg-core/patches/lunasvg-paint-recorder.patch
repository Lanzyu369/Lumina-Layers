+bool sourcePathMatchesRecordedFloat(
+    const SVGElement* source, const Path& path)
+{
+    if(source == nullptr)
+        return false;
+    PaintCommand exact;
+    bool containsArc = false;
+    double loweringPrecisionError = 0.0;
+    if(!recordExactSourcePath(
+            source, exact, containsArc, loweringPrecisionError))
+        return false;
+
+    PathIterator iterator(path);
+    std::array<Point, 3> points;
+    size_t verbIndex = 0;
+    size_t pointIndex = 0;
+    const auto pointMatches = [&](const Point& point) {
+        if(pointIndex >= exact.path_points.size())
+            return false;
+        const auto& exactPoint = exact.path_points[pointIndex++];
+        return exactPoint.x == static_cast<double>(point.x)
+            && exactPoint.y == static_cast<double>(point.y);
+    };
+    while(!iterator.isDone()) {
+        if(verbIndex >= exact.path_verbs.size())
+            return false;
+        const auto segment = iterator.currentSegment(points);
+        const auto expected = exact.path_verbs[verbIndex++];
+        if(segment == PathCommand::MoveTo) {
+            if(expected != PaintPathVerb::MoveTo || !pointMatches(points[0]))
+                return false;
+        } else if(segment == PathCommand::LineTo) {
+            if(expected != PaintPathVerb::LineTo || !pointMatches(points[0]))
+                return false;
+        } else if(segment == PathCommand::CubicTo) {
+            if(expected != PaintPathVerb::CubicTo
+                    || !pointMatches(points[0])
+                    || !pointMatches(points[1])
+                    || !pointMatches(points[2]))
+                return false;
+        } else if(expected != PaintPathVerb::Close) {
+            return false;
+        }
+        iterator.next();
+    }
+    return verbIndex == exact.path_verbs.size()
+        && pointIndex == exact.path_points.size();
+}
