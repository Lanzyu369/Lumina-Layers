+PaintTransform rawMultiply(const PaintTransform& left,
+                           const PaintTransform& right)
+{
+    return {
+        left.a * right.a + left.b * right.c,
+        left.a * right.b + left.b * right.d,
+        left.c * right.a + left.d * right.c,
+        left.c * right.b + left.d * right.d,
+        left.e * right.a + left.f * right.c + right.e,
+        left.e * right.b + left.f * right.d + right.f,
+    };
+}
+
+bool inverseTransform(const PaintTransform& value, PaintTransform& inverse)
+{
+    const double determinant = value.a * value.d - value.b * value.c;
+    if(!std::isfinite(determinant) || determinant == 0.0)
+        return false;
+    const double scale = 1.0 / determinant;
+    inverse = {
+        value.d * scale,
+        -value.b * scale,
+        -value.c * scale,
+        value.a * scale,
+        (value.c * value.f - value.d * value.e) * scale,
+        (value.b * value.e - value.a * value.f) * scale,
+    };
+    return true;
+}
+
+void skipTransformSpaces(std::string_view& input)
+{
+    while(!input.empty() && IS_WS(input.front()))
+        input.remove_prefix(1);
+}
+
+bool parseTransformArguments(std::string_view& input,
+                             std::array<double, 6>& values,
+                             size_t& count)
+{
+    skipTransformSpaces(input);
+    if(input.empty() || input.front() != '(')
+        return false;
+    input.remove_prefix(1);
+    count = 0;
+    while(true) {
+        skipTransformSpaces(input);
+        if(input.empty())
+            return false;
+        if(input.front() == ')') {
+            input.remove_prefix(1);
+            return true;
+        }
+        if(count == values.size()
+                || !parseNumber(input, values[count])
+                || !std::isfinite(values[count]))
+            return false;
+        ++count;
+        skipTransformSpaces(input);
+        if(!input.empty() && input.front() == ',')
+            input.remove_prefix(1);
+    }
+}
+
+PaintTransform translated(double x, double y)
+{
+    return {1, 0, 0, 1, x, y};
+}
+
+PaintTransform scaled(double x, double y)
+{
+    return {x, 0, 0, y, 0, 0};
+}
+
+PaintTransform rotated(double degrees)
+{
+    constexpr double RADIANS_PER_DEGREE =
+        3.141592653589793238462643383279502884 / 180.0;
+    const double radians = degrees * RADIANS_PER_DEGREE;
+    const double cosine = std::cos(radians);
+    const double sine = std::sin(radians);
+    return {cosine, sine, -sine, cosine, 0, 0};
+}
+
+PaintTransform sheared(double xDegrees, double yDegrees)
+{
+    constexpr double RADIANS_PER_DEGREE =
+        3.141592653589793238462643383279502884 / 180.0;
+    return {
+        1,
+        std::tan(yDegrees * RADIANS_PER_DEGREE),
+        std::tan(xDegrees * RADIANS_PER_DEGREE),
+        1,
+        0,
+        0,
+    };
+}
+
+bool parseExactTransform(std::string_view input, PaintTransform& result)
+{
+    result = {};
+    skipTransformSpaces(input);
+    while(!input.empty()) {
+        const size_t nameLength = [&]() {
+            size_t length = 0;
+            while(length < input.size() && IS_ALPHA(input[length]))
+                ++length;
+            return length;
+        }();
+        if(nameLength == 0)
+            return false;
+        const auto name = input.substr(0, nameLength);
+        input.remove_prefix(nameLength);
+        std::array<double, 6> values{};
+        size_t count = 0;
+        if(!parseTransformArguments(input, values, count))
+            return false;
+        PaintTransform operation;
+        if(name == "matrix" && count == 6) {
+            operation = {
+                values[0], values[1], values[2],
+                values[3], values[4], values[5],
+            };
+        } else if(name == "translate" && (count == 1 || count == 2)) {
+            operation = translated(values[0], count == 2 ? values[1] : 0);
+        } else if(name == "scale" && (count == 1 || count == 2)) {
+            operation = scaled(values[0], count == 2 ? values[1] : values[0]);
+        } else if(name == "rotate" && (count == 1 || count == 3)) {
+            if(count == 3)
+                result = composeRecordingTransforms(
+                    result, translated(values[1], values[2]));
+            operation = rotated(values[0]);
+            if(count == 3) {
+                result = composeRecordingTransforms(result, operation);
+                operation = translated(-values[1], -values[2]);
+            }
+        } else if(name == "skewX" && count == 1) {
+            operation = sheared(values[0], 0);
+        } else if(name == "skewY" && count == 1) {
+            operation = sheared(0, values[0]);
+        } else {
+            return false;
+        }
+        result = composeRecordingTransforms(result, operation);
+        skipTransformSpaces(input);
+        if(!input.empty() && input.front() == ',') {
+            input.remove_prefix(1);
+            skipTransformSpaces(input);
+        }
+    }
+    return true;
+}
+
+void skipExactPathSeparators(std::string_view& input)
+{
+    while(!input.empty()
+            && (IS_WS(input.front()) || input.front() == ','))
+        input.remove_prefix(1);
+}
+
+size_t exactPathParameterCount(char command)
+{
+    switch(static_cast<char>(std::tolower(
+            static_cast<unsigned char>(command)))) {
+    case 'm':
+    case 'l': return 2;
+    case 'h':
+    case 'v': return 1;
+    case 'c': return 6;
+    case 's': return 4;
+    case 'q': return 4;
+    case 't': return 2;
+    case 'a': return 7;
+    default: return 0;
+    }
+}
+
+bool appendExactArc(std::vector<PaintPathVerb>& verbs,
+                    std::vector<PaintPoint>& points,
+                    double startX, double startY,
+                    const std::array<double, 7>& values,
+                    bool relative, double& endX, double& endY,
+                    double& maximumLoweringError)
+{
+    constexpr double PI =
+        3.141592653589793238462643383279502884;
+    double radiusX = std::abs(values[0]);
+    double radiusY = std::abs(values[1]);
+    const double reducedAngleDegrees = std::fmod(values[2], 360.0);
+    const double angle = reducedAngleDegrees * PI / 180.0;
+    const bool largeArc = values[3] == 1.0;
+    const bool sweep = values[4] == 1.0;
+    if((values[3] != 0.0 && values[3] != 1.0)
+            || (values[4] != 0.0 && values[4] != 1.0))
+        return false;
+    endX = relative ? startX + values[5] : values[5];
+    endY = relative ? startY + values[6] : values[6];
+    if(radiusX == 0.0 || radiusY == 0.0
+            || (startX == endX && startY == endY)) {
+        verbs.push_back(PaintPathVerb::LineTo);
+        points.push_back({endX, endY});
+        return true;
+    }
+
+    const double cosine = std::cos(angle);
+    const double sine = std::sin(angle);
+    double deltaX = (startX - endX) * 0.5;
+    double deltaY = (startY - endY) * 0.5;
+    const double rotatedX = cosine * deltaX + sine * deltaY;
+    const double rotatedY = -sine * deltaX + cosine * deltaY;
+    deltaX = rotatedX;
+    deltaY = rotatedY;
+    const double radiusScale = deltaX * deltaX / (radiusX * radiusX)
+        + deltaY * deltaY / (radiusY * radiusY);
+    if(radiusScale > 1.0) {
+        const double scale = std::sqrt(radiusScale);
+        radiusX *= scale;
+        radiusY *= scale;
+    }
+    constexpr double ARC_CUBIC_RELATIVE_ERROR = 1.0e-6;
+    constexpr double ARC_OPERATION_ULPS = 64.0;
+    const double arithmeticMagnitude = std::max({
+        1.0, std::abs(startX), std::abs(startY),
+        std::abs(endX), std::abs(endY), radiusX, radiusY,
+    });
+    maximumLoweringError = std::max(
+        maximumLoweringError,
+        std::max(radiusX, radiusY) * ARC_CUBIC_RELATIVE_ERROR
+            + arithmeticMagnitude
+                * std::numeric_limits<double>::epsilon()
+                * ARC_OPERATION_ULPS);
+
+    const auto normalize = [&](double x, double y) {
+        return PaintPoint{
+            (cosine * x + sine * y) / radiusX,
+            (-sine * x + cosine * y) / radiusY,
+        };
+    };
+    const auto sourceStart = normalize(startX, startY);
+    const auto sourceEnd = normalize(endX, endY);
+    double chordX = sourceEnd.x - sourceStart.x;
+    double chordY = sourceEnd.y - sourceStart.y;
+    const double chordLengthSquared = chordX * chordX + chordY * chordY;
+    if(!(std::isfinite(chordLengthSquared) && chordLengthSquared > 0.0))
+        return false;
+    double centerScaleSquared = 1.0 / chordLengthSquared - 0.25;
+    centerScaleSquared = std::max(0.0, centerScaleSquared);
+    double centerScale = std::sqrt(centerScaleSquared);
+    if(sweep == largeArc)
+        centerScale = -centerScale;
+    chordX *= centerScale;
+    chordY *= centerScale;
+    const double centerX = 0.5 * (sourceStart.x + sourceEnd.x) - chordY;
+    const double centerY = 0.5 * (sourceStart.y + sourceEnd.y) + chordX;
+    const double startAngle = std::atan2(
+        sourceStart.y - centerY, sourceStart.x - centerX);
+    const double endAngle = std::atan2(
+        sourceEnd.y - centerY, sourceEnd.x - centerX);
+    double sweepAngle = endAngle - startAngle;
+    if(sweepAngle < 0.0 && sweep)
+        sweepAngle += 2.0 * PI;
+    else if(sweepAngle > 0.0 && !sweep)
+        sweepAngle -= 2.0 * PI;
+    const size_t segmentCount = std::max<size_t>(
+        1, static_cast<size_t>(std::ceil(
+            std::abs(sweepAngle) / (PI / 8.0))));
+    const auto denormalize = [&](double x, double y) {
+        return PaintPoint{
+            radiusX * x * cosine - radiusY * y * sine,
+            radiusX * x * sine + radiusY * y * cosine,
+        };
+    };
+    for(size_t index = 0; index < segmentCount; ++index) {
+        const double firstAngle = startAngle
+            + static_cast<double>(index) * sweepAngle / segmentCount;
+        const double lastAngle = startAngle
+            + static_cast<double>(index + 1) * sweepAngle / segmentCount;
+        const double tangent = 4.0 / 3.0
+            * std::tan(0.25 * (lastAngle - firstAngle));
+        auto control1 = denormalize(
+            std::cos(firstAngle) - tangent * std::sin(firstAngle)
+                + centerX,
+            std::sin(firstAngle) + tangent * std::cos(firstAngle)
+                + centerY);
+        auto control2 = denormalize(
+            std::cos(lastAngle) + tangent * std::sin(lastAngle) + centerX,
+            std::sin(lastAngle) - tangent * std::cos(lastAngle) + centerY);
+        auto endpoint = denormalize(
+            std::cos(lastAngle) + centerX,
+            std::sin(lastAngle) + centerY);
+        if(index + 1 == segmentCount)
+            endpoint = {endX, endY};
+        verbs.push_back(PaintPathVerb::CubicTo);
+        points.push_back(control1);
+        points.push_back(control2);
+        points.push_back(endpoint);
+    }
+    return true;
+}
+
+bool parseExactLengthAttribute(const SVGElement* source, PropertyID property,
+                               LengthDirection direction,
+                               double defaultValue, bool required,
+                               double& value)
+{
+    std::string_view input(source->getAttribute(property));
+    stripLeadingAndTrailingSpaces(input);
+    if(input.empty()) {
+        if(required)
+            return false;
+        value = defaultValue;
+        return true;
+    }
+    if(!parseNumber(input, value) || !std::isfinite(value))
+        return false;
+    if(input.empty())
+        return true;
+
+    if(input == "px")
+        return true;
+    if(input == "pc") {
+        value *= 16.0;
+        return std::isfinite(value);
+    }
+    if(input == "pt") {
+        value *= 96.0 / 72.0;
+        return std::isfinite(value);
+    }
+    if(input == "in") {
+        value *= 96.0;
+        return std::isfinite(value);
+    }
+    if(input == "cm") {
+        value *= 96.0 / 2.54;
+        return std::isfinite(value);
+    }
+    if(input == "mm") {
+        value *= 96.0 / 25.4;
+        return std::isfinite(value);
+    }
+    if(input == "em") {
+        value *= static_cast<double>(source->font_size());
+        return std::isfinite(value);
+    }
+    if(input == "ex") {
+        value *= static_cast<double>(source->font_size()) / 2.0;
+        return std::isfinite(value);
+    }
+    if(input == "%") {
+        const auto viewport = source->currentViewportSize();
+        double dimension = 0.0;
+        switch(direction) {
+        case LengthDirection::Horizontal:
+            dimension = viewport.w;
+            break;
+        case LengthDirection::Vertical:
+            dimension = viewport.h;
+            break;
+        case LengthDirection::Diagonal:
+            dimension = std::hypot(
+                static_cast<double>(viewport.w),
+                static_cast<double>(viewport.h)) / std::sqrt(2.0);
+            break;
+        }
+        value *= dimension / 100.0;
+        return std::isfinite(value);
+    }
+    return false;
+}
+
+void appendExactMove(PaintCommand& command, double x, double y)
+{
+    command.path_verbs.push_back(PaintPathVerb::MoveTo);
+    command.path_points.push_back({x, y});
+}
+
+void appendExactLine(PaintCommand& command, double x, double y)
+{
+    command.path_verbs.push_back(PaintPathVerb::LineTo);
+    command.path_points.push_back({x, y});
+}
+
+bool appendExactEllipse(PaintCommand& command,
+                        double centerX, double centerY,
+                        double radiusX, double radiusY,
+                        double& loweringPrecisionError)
+{
+    if(!(radiusX > 0.0 && radiusY > 0.0))
+        return false;
+    appendExactMove(command, centerX + radiusX, centerY);
+    std::array<double, 7> arc{{
+        radiusX, radiusY, 0.0, 0.0, 1.0,
+        centerX - radiusX, centerY,
+    }};
+    double endX = 0;
+    double endY = 0;
+    if(!appendExactArc(
+            command.path_verbs, command.path_points,
+            centerX + radiusX, centerY, arc, false,
+            endX, endY, loweringPrecisionError))
+        return false;
+    arc[5] = centerX + radiusX;
+    if(!appendExactArc(
+            command.path_verbs, command.path_points,
+            endX, endY, arc, false,
+            endX, endY, loweringPrecisionError))
+        return false;
+    command.path_verbs.push_back(PaintPathVerb::Close);
+    return true;
+}
+
+bool recordExactPrimitive(const SVGElement* source,
+                          PaintCommand& command,
+                          bool& containsArc,
+                          double& loweringPrecisionError)
+{
+    const auto read = [&](PropertyID property, double defaultValue,
+                          bool required, LengthDirection direction,
+                          double& value) {
+        return parseExactLengthAttribute(
+            source, property, direction, defaultValue, required, value);
+    };
+    if(source->id() == ElementID::Line) {
+        double x1 = 0;
+        double y1 = 0;
+        double x2 = 0;
+        double y2 = 0;
+        if(!read(PropertyID::X1, 0.0, false,
+                    LengthDirection::Horizontal, x1)
+                || !read(PropertyID::Y1, 0.0, false,
+                    LengthDirection::Vertical, y1)
+                || !read(PropertyID::X2, 0.0, false,
+                    LengthDirection::Horizontal, x2)
+                || !read(PropertyID::Y2, 0.0, false,
+                    LengthDirection::Vertical, y2))
+            return false;
+        appendExactMove(command, x1, y1);
+        appendExactLine(command, x2, y2);
+        return true;
+    }
+    if(source->id() == ElementID::Circle
+            || source->id() == ElementID::Ellipse) {
+        double centerX = 0;
+        double centerY = 0;
+        double radiusX = 0;
+        double radiusY = 0;
+        if(!read(PropertyID::Cx, 0.0, false,
+                    LengthDirection::Horizontal, centerX)
+                || !read(PropertyID::Cy, 0.0, false,
+                    LengthDirection::Vertical, centerY))
+            return false;
+        if(source->id() == ElementID::Circle) {
+            if(!read(PropertyID::R, 0.0, true,
+                    LengthDirection::Diagonal, radiusX))
+                return false;
+            radiusY = radiusX;
+        } else if(!read(PropertyID::Rx, 0.0, true,
+                    LengthDirection::Horizontal, radiusX)
+                || !read(PropertyID::Ry, 0.0, true,
+                    LengthDirection::Vertical, radiusY)) {
+            return false;
+        }
+        containsArc = true;
+        return appendExactEllipse(
+            command, centerX, centerY, radiusX, radiusY,
+            loweringPrecisionError);
+    }
+    if(source->id() == ElementID::Rect) {
+        double x = 0;
+        double y = 0;
+        double width = 0;
+        double height = 0;
+        double radiusX = 0;
+        double radiusY = 0;
+        const bool hasRadiusX = source->hasAttribute(PropertyID::Rx);
+        const bool hasRadiusY = source->hasAttribute(PropertyID::Ry);
+        if(!read(PropertyID::X, 0.0, false,
+                    LengthDirection::Horizontal, x)
+                || !read(PropertyID::Y, 0.0, false,
+                    LengthDirection::Vertical, y)
+                || !read(PropertyID::Width, 0.0, true,
+                    LengthDirection::Horizontal, width)
+                || !read(PropertyID::Height, 0.0, true,
+                    LengthDirection::Vertical, height)
+                || (hasRadiusX
+                    && !read(PropertyID::Rx, 0.0, true,
+                        LengthDirection::Horizontal, radiusX))
+                || (hasRadiusY
+                    && !read(PropertyID::Ry, 0.0, true,
+                        LengthDirection::Vertical, radiusY))
+                || !(width > 0.0 && height > 0.0))
+            return false;
+        if(!hasRadiusX)
+            radiusX = radiusY;
+        if(!hasRadiusY)
+            radiusY = radiusX;
+        radiusX = std::min(radiusX, width * 0.5);
+        radiusY = std::min(radiusY, height * 0.5);
+        if(!(radiusX > 0.0 && radiusY > 0.0)) {
+            appendExactMove(command, x, y);
+            appendExactLine(command, x + width, y);
+            appendExactLine(command, x + width, y + height);
+            appendExactLine(command, x, y + height);
+            command.path_verbs.push_back(PaintPathVerb::Close);
+            return true;
+        }
+        containsArc = true;
+        appendExactMove(command, x + radiusX, y);
+        appendExactLine(command, x + width - radiusX, y);
+        const std::array<std::array<double, 2>, 4> endpoints{{
+            {{x + width, y + radiusY}},
+            {{x + width - radiusX, y + height}},
+            {{x, y + height - radiusY}},
+            {{x + radiusX, y}},
+        }};
+        const std::array<std::array<double, 2>, 3> lineEnds{{
+            {{x + width, y + height - radiusY}},
+            {{x + radiusX, y + height}},
+            {{x, y + radiusY}},
+        }};
+        double startX = x + width - radiusX;
+        double startY = y;
+        for(size_t index = 0; index < endpoints.size(); ++index) {
+            std::array<double, 7> arc{{
+                radiusX, radiusY, 0.0, 0.0, 1.0,
+                endpoints[index][0], endpoints[index][1],
+            }};
+            double endX = 0;
+            double endY = 0;
+            if(!appendExactArc(
+                    command.path_verbs, command.path_points,
+                    startX, startY, arc, false,
+                    endX, endY, loweringPrecisionError))
+                return false;
+            startX = endX;
+            startY = endY;
+            if(index < lineEnds.size()) {
+                startX = lineEnds[index][0];
+                startY = lineEnds[index][1];
+                appendExactLine(command, startX, startY);
+            }
+        }
+        command.path_verbs.push_back(PaintPathVerb::Close);
+        return true;
+    }
+    if(source->id() == ElementID::Polyline
+            || source->id() == ElementID::Polygon) {
+        std::string_view input(source->getAttribute(PropertyID::Points));
+        skipExactPathSeparators(input);
+        bool first = true;
+        while(!input.empty()) {
+            double x = 0;
+            double y = 0;
+            if(!parseNumber(input, x) || !std::isfinite(x))
+                return false;
+            skipExactPathSeparators(input);
+            if(!parseNumber(input, y) || !std::isfinite(y))
+                return false;
+            skipExactPathSeparators(input);
+            if(first) {
+                appendExactMove(command, x, y);
+                first = false;
+            } else {
+                appendExactLine(command, x, y);
+            }
+        }
+        if(first)
+            return false;
+        if(source->id() == ElementID::Polygon)
+            command.path_verbs.push_back(PaintPathVerb::Close);
+        return true;
+    }
+    return false;
+}
+
+bool isExactPrimitiveSource(ElementID id)
+{
+    return id == ElementID::Line || id == ElementID::Circle
+        || id == ElementID::Ellipse || id == ElementID::Rect
+        || id == ElementID::Polyline || id == ElementID::Polygon;
+}
+
+bool recordExactSourcePath(const SVGElement* source,
+                           PaintCommand& command,
+                           bool& containsArc,
+                           double& loweringPrecisionError)
+{
+    containsArc = false;
+    loweringPrecisionError = 0.0;
+    PaintCommand exactCommand;
+    if(source->id() != ElementID::Path) {
+        if(!recordExactPrimitive(
+                source, exactCommand, containsArc,
+                loweringPrecisionError))
+            return false;
+        command.path_verbs = std::move(exactCommand.path_verbs);
+        command.path_points = std::move(exactCommand.path_points);
+        return true;
+    }
+    std::string_view input(source->getAttribute(PropertyID::D));
+    char activeCommand = 0;
+    char previousCommand = 0;
+    double currentX = 0;
+    double currentY = 0;
+    double startX = 0;
+    double startY = 0;
+    double previousControlX = 0;
+    double previousControlY = 0;
+    double previousQuadraticX = 0;
+    double previousQuadraticY = 0;
+    skipExactPathSeparators(input);
+    while(!input.empty()) {
+        if(IS_ALPHA(input.front())) {
+            activeCommand = input.front();
+            input.remove_prefix(1);
+            skipExactPathSeparators(input);
+        }
+        if(activeCommand == 0)
+            return false;
+        const char executedCommand = activeCommand;
+        const char normalized = static_cast<char>(std::tolower(
+            static_cast<unsigned char>(executedCommand)));
+        if(normalized == 'z') {
+            exactCommand.path_verbs.push_back(PaintPathVerb::Close);
+            currentX = startX;
+            currentY = startY;
+            previousCommand = executedCommand;
+            activeCommand = 0;
+            skipExactPathSeparators(input);
+            continue;
+        }
+        const size_t parameterCount = exactPathParameterCount(
+            executedCommand);
+        if(parameterCount == 0)
+            return false;
+        std::array<double, 7> values{};
+        for(size_t index = 0; index < parameterCount; ++index) {
+            if(!parseNumber(input, values[index])
+                    || !std::isfinite(values[index]))
+                return false;
+            skipExactPathSeparators(input);
+        }
+        const bool relative = executedCommand >= 'a'
+            && executedCommand <= 'z';
+        const auto coordinate = [relative](double value, double current) {
+            return relative ? current + value : value;
+        };
+        if(normalized == 'm') {
+            currentX = coordinate(values[0], currentX);
+            currentY = coordinate(values[1], currentY);
+            startX = currentX;
+            startY = currentY;
+            exactCommand.path_verbs.push_back(PaintPathVerb::MoveTo);
+            exactCommand.path_points.push_back({currentX, currentY});
+            activeCommand = relative ? 'l' : 'L';
+        } else if(normalized == 'l') {
+            currentX = coordinate(values[0], currentX);
+            currentY = coordinate(values[1], currentY);
+            exactCommand.path_verbs.push_back(PaintPathVerb::LineTo);
+            exactCommand.path_points.push_back({currentX, currentY});
+        } else if(normalized == 'h') {
+            currentX = coordinate(values[0], currentX);
+            exactCommand.path_verbs.push_back(PaintPathVerb::LineTo);
+            exactCommand.path_points.push_back({currentX, currentY});
+        } else if(normalized == 'v') {
+            currentY = coordinate(values[0], currentY);
+            exactCommand.path_verbs.push_back(PaintPathVerb::LineTo);
+            exactCommand.path_points.push_back({currentX, currentY});
+        } else if(normalized == 'c') {
+            const double control1X = coordinate(values[0], currentX);
+            const double control1Y = coordinate(values[1], currentY);
+            const double control2X = coordinate(values[2], currentX);
+            const double control2Y = coordinate(values[3], currentY);
