+namespace {
+
+
+struct UseCloneEstimate {
+    size_t cloneWork{0};
+    size_t expansionWork{0};
+};
+
+struct UseCloneCacheKey {
+    int32_t targetSourceIndex;
+    size_t activeDepth;
+    std::vector<int32_t> ancestorSourceIds;
+
+    bool operator<(const UseCloneCacheKey& other) const
+    {
+        if(targetSourceIndex != other.targetSourceIndex)
+            return targetSourceIndex < other.targetSourceIndex;
+        if(activeDepth != other.activeDepth)
+            return activeDepth < other.activeDepth;
+        return ancestorSourceIds < other.ancestorSourceIds;
+    }
+};
+
+bool addCloneWork(size_t amount, UseCloneEstimate& estimate)
+{
+    if(amount > std::numeric_limits<size_t>::max() - estimate.cloneWork)
+        return false;
+    estimate.cloneWork += amount;
+    return true;
+}
+
+bool addExpansionWork(size_t amount, UseCloneEstimate& estimate)
+{
+    if(amount > std::numeric_limits<size_t>::max() - estimate.expansionWork)
+        return false;
+    estimate.expansionWork += amount;
+    return true;
+}
+
+bool addEstimate(const UseCloneEstimate& addition,
+                 UseCloneEstimate& estimate)
+{
+    return addCloneWork(addition.cloneWork, estimate)
+        && addExpansionWork(addition.expansionWork, estimate);
+}
+
+bool addCloneAttributeWork(const AttributeList& attributes,
+                           UseCloneEstimate& estimate)
+{
+    for(const auto& attribute : attributes) {
+        if(!addCloneWork(attribute.value().size() + 1, estimate))
+            return false;
+    }
+    return true;
+}
+
+bool addCloneSubtreeWork(const SVGElement* element,
+                         UseCloneEstimate& estimate)
+{
+    if(!addCloneAttributeWork(element->attributes(), estimate))
+        return false;
+    for(const auto& child : element->children()) {
+        if(auto childElement = toSVGElement(child)) {
+            if(!addCloneSubtreeWork(childElement, estimate))
+                return false;
+        }
+    }
+    return true;
+}
+
+class UseClonePreflight {
+public:
+    explicit UseClonePreflight(Document* document)
+        : m_document(document)
+    {}
+
+    bool estimate(const SVGElement* root)
+    {
+        std::vector<int32_t> ancestorSourceIds;
+        return estimateBuiltElement(root, true, ancestorSourceIds, 0,
+                                    m_estimate);
+    }
+
+private:
+    using AncestorSourceIds = std::vector<int32_t>;
+
+    static void appendElementId(const SVGElement* element,
+                                AncestorSourceIds& ancestorSourceIds)
+    {
+        if(!element->getAttribute(PropertyID::Id).empty())
+            ancestorSourceIds.push_back(element->sourceIndex());
+    }
+
+    static bool containsTargetId(const SVGElement* targetElement,
+                                 const AncestorSourceIds& ancestorSourceIds)
+    {
+        return std::find(ancestorSourceIds.begin(), ancestorSourceIds.end(),
+                         targetElement->sourceIndex())
+            != ancestorSourceIds.end();
+    }
+
+    bool estimateBuiltElement(const SVGElement* element,
+                              bool originalInstance,
+                              const AncestorSourceIds& ancestorSourceIds,
+                              size_t activeDepth,
+                              UseCloneEstimate& estimate)
+    {
+        if(element->id() == ElementID::Use) {
+            return estimateUse(
+                static_cast<const SVGUseElement*>(element), originalInstance,
+                true, ancestorSourceIds, activeDepth, estimate);
+        }
+
+        auto childAncestors = ancestorSourceIds;
+        appendElementId(element, childAncestors);
+        for(const auto& child : element->children()) {
+            if(auto childElement = toSVGElement(child)) {
+                if(!estimateBuiltElement(childElement, originalInstance,
+                                         childAncestors, activeDepth,
+                                         estimate)) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    bool estimateUse(const SVGUseElement* useElement,
+                     bool originalInstance,
+                     bool includeSourceChildren,
+                     const AncestorSourceIds& ancestorSourceIds,
+                     size_t activeDepth,
+                     UseCloneEstimate& estimate)
+    {
+        if(!addExpansionWork(1, estimate)) {
+            return false;
+        }
+
+        auto childAncestors = ancestorSourceIds;
+        appendElementId(useElement, childAncestors);
+        auto* targetElement = useElement->getTargetElement(m_document);
+        const bool canClone = targetElement != nullptr
+            && (!originalInstance || targetElement != useElement)
+            && !isDisallowedElement(targetElement)
+            && !containsTargetId(targetElement, ancestorSourceIds);
+
+        if(canClone) {
+            if(targetElement->id() == ElementID::Svg
+                    || targetElement->id() == ElementID::Symbol) {
+                for(const auto& attribute : useElement->attributes()) {
+                    if(attribute.id() != PropertyID::Width
+                            && attribute.id() != PropertyID::Height) {
+                        continue;
+                    }
+                    if(!addCloneWork(attribute.value().size() + 1, estimate))
+                        return false;
+                }
+            }
+            if(!estimateClonedTarget(targetElement, childAncestors,
+                                     activeDepth + 1, estimate)) {
+                return false;
+            }
+        }
+
+        if(includeSourceChildren) {
+            for(const auto& child : useElement->children()) {
+                if(auto childElement = toSVGElement(child)) {
+                    if(!estimateBuiltElement(childElement, originalInstance,
+                                             childAncestors, activeDepth + 1,
+                                             estimate)) {
+                        return false;
+                    }
+                }
+            }
+        }
+        return true;
+    }
+
+    bool estimateClonedTarget(const SVGElement* targetElement,
+                              const AncestorSourceIds& ancestorSourceIds,
+                              size_t activeDepth,
+                              UseCloneEstimate& estimate)
+    {
+        const UseCloneCacheKey key{
+            targetElement->sourceIndex(), activeDepth, ancestorSourceIds};
+        const auto cached = m_targetCache.find(key);
+        if(cached != m_targetCache.end())
+            return addEstimate(cached->second, estimate);
+
+        UseCloneEstimate targetEstimate;
+        if(targetElement->id() == ElementID::Use) {
+            if(!addCloneAttributeWork(targetElement->attributes(),
+                                      targetEstimate)
+                    || !estimateUse(
+                        static_cast<const SVGUseElement*>(targetElement),
+                        false, false, ancestorSourceIds, activeDepth,
+                        targetEstimate)) {
+                return false;
+            }
+        } else {
+            if(!addCloneSubtreeWork(targetElement, targetEstimate))
+                return false;
+            auto childAncestors = ancestorSourceIds;
+            appendElementId(targetElement, childAncestors);
+            for(const auto& child : targetElement->children()) {
+                if(auto childElement = toSVGElement(child)) {
+                    if(!estimateBuiltElement(childElement, false,
+                                             childAncestors, activeDepth,
+                                             targetEstimate)) {
+                        return false;
+                    }
+                }
+            }
+        }
+
+        m_targetCache.emplace(key, targetEstimate);
+        return addEstimate(targetEstimate, estimate);
+    }
+
+    Document* m_document;
+    std::map<UseCloneCacheKey, UseCloneEstimate> m_targetCache;
+    UseCloneEstimate m_estimate;
+};
+
+} // namespace
+
+bool Document::preflightUseCloneWork()
+{
+    if(!m_capabilityIssues.empty()) {
+        m_useClonePreflightState = 2;
+        return false;
+    }
+    if(m_useClonePreflightState != 0)
+        return m_useClonePreflightState == 1;
+
+    UseClonePreflight preflight(this);
+    const bool withinBudget = preflight.estimate(m_rootElement.get());
+    if(!withinBudget)
+        addCapabilityIssue("unsupported_complexity");
+    m_useClonePreflightState = withinBudget ? 1 : 2;
+    return withinBudget;
+}
+
 } // namespace lunasvg
