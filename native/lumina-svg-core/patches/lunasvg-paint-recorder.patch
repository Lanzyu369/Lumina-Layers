+static bool isLegacyPaintKeyword(std::string_view value)
+{
+    // Keep v0.1 on the small named-color intersection whose values are
+    // identical in PlutoVG and Lumina's pinned svgelements parser. Other
+    // names (notably rebeccapurple and legacy's divergent aliceblue entry)
+    // use whole-document fallback instead of changing material identity.
+    static constexpr std::string_view names[] = {
+        "aqua", "black", "blue", "fuchsia", "gray", "green",
+        "lime", "maroon", "navy", "olive", "purple", "red",
+        "silver", "teal", "transparent", "white", "yellow",
+    };
+    const auto lowered = lowerAscii(value);
+    return std::find(std::begin(names), std::end(names), lowered)
+        != std::end(names);
