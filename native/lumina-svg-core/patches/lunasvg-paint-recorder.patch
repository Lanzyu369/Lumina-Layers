+            dashArray.begin(), dashArray.end());
+        m_recorder->recorded_dash_value_count += dashArray.size();
+    }
+
+    if(recordedExactSourcePath) {
+        m_recorder->recorded_path_verb_count += command.path_verbs.size();
+        m_recorder->recorded_path_point_count += command.path_points.size();
+        for(const auto verb : command.path_verbs) {
+            if(verb != PaintPathVerb::MoveTo)
+                continue;
+            command.source_subpath_area_potential.push_back(
+                sourceSubpathIndex < declaredSubpaths.size()
+                    ? declaredSubpaths[sourceSubpathIndex]
