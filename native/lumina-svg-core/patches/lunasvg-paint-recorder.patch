+    command.transform_operation_count = m_transformOperationCount;
+    command.path_input_precision_error = source->relativePathPrecisionError();
+    command.transform_linear_precision_error = m_transformLinearPrecisionError;
+    command.transform_translation_precision_error = m_transformTranslationPrecisionError;
