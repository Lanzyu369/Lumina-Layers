+    command.kind = kind;
+    command.transform = m_recordingTransform;
+    command.rgba = {{color.red(), color.green(), color.blue(), color.alpha()}};
+    command.fill_rule = fillRule == FillRule::EvenOdd
+        ? PaintFillRule::EvenOdd : PaintFillRule::NonZero;
+    command.has_partial_alpha = hasPartialAlpha;
+    command.paint_opacity = paintOpacity;
+    command.source_index = source->sourceIndex();
+    command.relative_path_operation_count = source->relativePathOperationCount();
+    command.transform_operation_count = m_transformOperationCount;
+    command.path_input_precision_error = source->relativePathPrecisionError();
+    command.path_input_precision_error_x = source->relativePathPrecisionErrorX();
+    command.path_input_precision_error_y = source->relativePathPrecisionErrorY();
+    command.source_has_lowered_curve = source->sourceHasLoweredCurve();
+    bool exactPathContainsArc = false;
+    double exactPathLoweringPrecisionError = 0.0;
+    const bool recordedExactSourcePath = recordExactSourcePath(
+        source, command, exactPathContainsArc,
+        exactPathLoweringPrecisionError);
+    if(!recordedExactSourcePath && isExactPrimitiveSource(source->id())) {
+        recordCapabilityIssue("unsupported_input_precision", source);
+        return;
+    }
+    command.path_coordinates_exact = recordedExactSourcePath;
+    command.transform_coordinates_exact = true;
+    if(recordedExactSourcePath) {
+        command.path_input_precision_error = 0;
+        command.path_input_precision_error_x = 0;
+        command.path_input_precision_error_y = 0;
+        command.path_lowering_precision_error =
+            exactPathLoweringPrecisionError;
+        command.source_has_lowered_curve = exactPathContainsArc;
+    }
+    if(source->id() == ElementID::Rect) {
