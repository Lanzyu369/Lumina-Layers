+        const auto magnitudeUpperBound = [](float value) {
+            const double magnitude = std::abs(static_cast<double>(value));
+            const double upward = std::abs(
+                static_cast<double>(std::nextafter(
+                    value, std::numeric_limits<float>::infinity()))
+                - value);
+            const double downward = std::abs(
+                static_cast<double>(value)
+                - std::nextafter(
