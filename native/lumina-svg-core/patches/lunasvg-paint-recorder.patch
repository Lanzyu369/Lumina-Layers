+static bool hasPrefix(std::string_view value, std::string_view prefix)
+{
+    return value.size() >= prefix.size()
+        && value.substr(0, prefix.size()) == prefix;
+}
+
+static bool isNonSemanticUnknownAttribute(std::string_view name)
+{
+    return name == "xmlns" || name == "version" || name == "role"
+        || name == "focusable" || name == "enable-background"
+        || hasPrefix(name, "xmlns:") || hasPrefix(name, "xml:")
+        || hasPrefix(name, "data-") || hasPrefix(name, "aria-")
+        || hasPrefix(name, "inkscape:") || hasPrefix(name, "sodipodi:");
+}
+
+static bool isPartialAlphaValue(std::string_view value)
+{
+    auto first = value.find_first_not_of(" \t\r\n");
+    if(first == std::string_view::npos)
+        return true;
+    auto last = value.find_last_not_of(" \t\r\n");
+    std::string text(value.substr(first, last - first + 1));
+    auto percent = !text.empty() && text.back() == '%';
+    if(percent)
+        text.pop_back();
+    char* end = nullptr;
+    auto parsed = std::strtof(text.c_str(), &end);
+    if(end == text.c_str() || *end != '\0')
+        return true;
+    if(percent)
+        parsed /= 100.f;
+    return parsed > 0.f && parsed < 1.f;
+}
+
+static std::string capabilityReasonForAttribute(std::string_view name,
+                                                std::string_view value,
+                                                bool known)
+{
+    auto firstValueCharacter = value.find_first_not_of(" \t\r\n");
+    if((name == "href" || name == "xlink:href")
+            && firstValueCharacter != std::string_view::npos
+            && value[firstValueCharacter] != '#')
+        return "unsupported_external_resource";
+    auto urlPosition = value.find("url(");
+    if(urlPosition != std::string_view::npos) {
+        auto urlValue = value.find_first_not_of(" \t\r\n'\"", urlPosition + 4);
+        if(urlValue != std::string_view::npos && value[urlValue] != '#')
+            return "unsupported_external_resource";
+    }
+    if(name == "vector-effect")
+        return "unsupported_vector_effect";
+    if(name == "marker" || name == "marker-start"
+            || name == "marker-mid" || name == "marker-end")
+        return "unsupported_marker";
+    if(name == "paint-order")
+        return "unsupported_paint_order";
+    if(name == "filter" || name == "backdrop-filter")
+        return "unsupported_filter";
+    if(name == "mix-blend-mode" || name == "isolation")
+        return "unsupported_blend_mode";
+    if(hasPrefix(name, "on"))
+        return "unsupported_script";
+    if((name == "opacity" || name == "fill-opacity"
+            || name == "stroke-opacity") && isPartialAlphaValue(value))
+        return "unsupported_partial_alpha";
+    if(!known && !isNonSemanticUnknownAttribute(name))
+        return "unsupported_property";
+    return {};
+}
+
+static std::string capabilityReasonForElement(std::string_view name,
+                                              ElementID id)
+{
+    if(name == "script")
+        return "unsupported_script";
+    if(id == ElementID::Image)
+        return "unsupported_image";
+    if(id == ElementID::Text || id == ElementID::Tspan)
+        return "unsupported_text";
+    if(id == ElementID::Unknown)
+        return "unsupported_element";
+    return {};
+}
