+static bool hasPrefix(std::string_view value, std::string_view prefix)
+{
+    return value.size() >= prefix.size()
+        && value.substr(0, prefix.size()) == prefix;
+}
+
+static std::string_view::size_type findUrlFunction(std::string_view value)
+{
+    for(size_t index = 0; index + 4 <= value.size(); ++index) {
+        if((value[index] == 'u' || value[index] == 'U')
+                && (value[index + 1] == 'r' || value[index + 1] == 'R')
+                && (value[index + 2] == 'l' || value[index + 2] == 'L')
+                && value[index + 3] == '(')
+            return index;
+    }
+    return std::string_view::npos;
+}
+
+static bool isNonSemanticUnknownAttribute(std::string_view name)
+{
+    return name == "xmlns" || name == "version" || name == "role"
+        || name == "focusable" || name == "enable-background"
+        || name == "xml:lang" || hasPrefix(name, "xmlns:")
+        || hasPrefix(name, "data-") || hasPrefix(name, "aria-")
+        || hasPrefix(name, "inkscape:") || hasPrefix(name, "sodipodi:");
+}
+
+static std::string_view trimmedValue(std::string_view value)
+{
+    auto first = value.find_first_not_of(" \t\r\n");
+    if(first == std::string_view::npos)
+        return {};
+    auto last = value.find_last_not_of(" \t\r\n");
+    return value.substr(first, last - first + 1);
+}
+
