+    if(urlPosition != std::string_view::npos) {
+        auto urlValue = value.find_first_not_of(" \t\r\n'\"", urlPosition + 4);
+        if(urlValue != std::string_view::npos && value[urlValue] != '#')
+            return "unsupported_external_resource";
