+    if(allowPercentage && !value.empty() && value.back() == '%') {
+        percentage = true;
+        value.remove_suffix(1);
+    }
+    bool negative = false;
+    if(!value.empty() && (value.front() == '+' || value.front() == '-')) {
+        negative = value.front() == '-';
