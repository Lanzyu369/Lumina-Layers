+    if(value.size() <= opening + 1 || value[opening] != '('
+            || value.back() != ')')
+        return false;
+    auto parameters = value.substr(opening + 1, value.size() - opening - 2);
+    std::array<std::string_view, 4> values;
+    size_t valueCount = 0;
+    while(true) {
+        if(valueCount >= values.size())
+            return false;
+        const auto comma = parameters.find(',');
+        values[valueCount++] = comma == std::string_view::npos
+            ? parameters : parameters.substr(0, comma);
+        if(comma == std::string_view::npos)
+            break;
+        parameters.remove_prefix(comma + 1);
+    }
+    if(valueCount != (hasAlpha ? 4u : 3u)
+            || !isLegacyByteColorChannel(values[0])
+            || !isLegacyByteColorChannel(values[1])
+            || !isLegacyByteColorChannel(values[2]))
