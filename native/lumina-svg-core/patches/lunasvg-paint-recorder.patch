+
+bool SVGRenderState::recordDeferredCapabilities()
+{
+    if(!m_recorder || m_recordingSuppressed)
+        return false;
+    for(const auto* state = this; state != nullptr; state = state->parent()) {
+        const auto* element = state->element();
+        if(element == nullptr)
+            continue;
+        for(const auto& item : element->deferredCapabilities()) {
+            const auto& capability = item.second;
+            if(capability.reason.empty())
+                continue;
+            recordCapabilityIssue(capability.reason, element);
+            m_recordingSuppressed = true;
+        }
+    }
+    return !m_recordingSuppressed;
+}
+
+void SVGRenderState::recordBoundary(PaintCommandKind kind,
+                                    const SVGElement* sourceElement,
+                                    double groupOpacity)
+{
+    if(!m_recorder || m_recordingSuppressed)
+        return;
+    auto source = sourceElement ? sourceElement : m_element;
+    if(m_recorder->complexity_exceeded) {
+        rejectRecorderComplexity(m_recorder, source);
+        return;
+    }
+    PaintCommand command;
+    command.kind = kind;
+    command.transform = m_recordingTransform;
+    command.transform_coordinates_exact = true;
+    command.group_opacity = groupOpacity;
+    command.source_index = source ? source->sourceIndex() : -1;
+    command.source_kind = kind == PaintCommandKind::ClipEnd ? "clip_end" : "group";
+    m_recorder->commands.emplace_back(std::move(command));
+}
+
+void SVGRenderState::recordPath(PaintCommandKind kind, const Path& path,
+                                FillRule fillRule,
+                                const StrokeData* strokeData,
+                                const SVGElement* sourceElement)
+{
+    if(!m_recorder || m_recordingSuppressed)
+        return;
+    auto source = sourceElement ? sourceElement : m_element;
+    if(!source)
+        return;
+    if(m_recorder->complexity_exceeded) {
+        rejectRecorderComplexity(m_recorder, source);
+        return;
+    }
+    if(!m_canvas->hasSolidPaint()) {
+        recordCapabilityIssue("unsupported_paint_server", source);
+        return;
+    }
