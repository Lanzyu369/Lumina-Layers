+    PathIterator iterator(path);
+    std::array<Point, 3> points;
+    while(!iterator.isDone()) {
+        auto pathCommand = iterator.currentSegment(points);
+        switch(pathCommand) {
+        case PathCommand::MoveTo:
+            command.path_verbs.push_back(PaintPathVerb::MoveTo);
+            command.path_points.push_back({points[0].x, points[0].y});
+            break;
+        case PathCommand::LineTo:
+            command.path_verbs.push_back(PaintPathVerb::LineTo);
+            command.path_points.push_back({points[0].x, points[0].y});
+            break;
+        case PathCommand::CubicTo:
+            command.path_verbs.push_back(PaintPathVerb::CubicTo);
+            command.path_points.push_back({points[0].x, points[0].y});
+            command.path_points.push_back({points[1].x, points[1].y});
+            command.path_points.push_back({points[2].x, points[2].y});
+            break;
+        case PathCommand::Close:
+            command.path_verbs.push_back(PaintPathVerb::Close);
+            break;
+        }
