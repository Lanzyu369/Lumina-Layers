+    command.transform = Matrix(m_currentTransform);
+    command.rgba = {{color.red(), color.green(), color.blue(), color.alpha()}};
+    command.fill_rule = fillRule == FillRule::EvenOdd
+        ? PaintFillRule::EvenOdd : PaintFillRule::NonZero;
+    command.source_index = source->sourceIndex();
+    command.source_kind = kind == PaintCommandKind::Stroke ? "stroke"
+        : kind == PaintCommandKind::ClipBegin ? "clip" : "fill";
+
+    if(strokeData) {
+        command.stroke.width = strokeData->lineWidth();
+        command.stroke.miter_limit = strokeData->miterLimit();
+        command.stroke.dash_offset = strokeData->dashOffset();
+        command.stroke.line_cap = static_cast<PaintLineCap>(strokeData->lineCap());
+        command.stroke.line_join = static_cast<PaintLineJoin>(strokeData->lineJoin());
+        command.stroke.dash_array = strokeData->dashArray();
+    }
+
+    PathIterator iterator(path);
+    std::array<Point, 3> points;
+    while(!iterator.isDone()) {
+        auto pathCommand = iterator.currentSegment(points);
+        switch(pathCommand) {
+        case PathCommand::MoveTo:
+            command.path_verbs.push_back(PaintPathVerb::MoveTo);
+            command.path_points.push_back({points[0].x, points[0].y});
+            break;
+        case PathCommand::LineTo:
+            command.path_verbs.push_back(PaintPathVerb::LineTo);
+            command.path_points.push_back({points[0].x, points[0].y});
+            break;
+        case PathCommand::CubicTo:
+            command.path_verbs.push_back(PaintPathVerb::CubicTo);
+            command.path_points.push_back({points[0].x, points[0].y});
+            command.path_points.push_back({points[1].x, points[1].y});
+            command.path_points.push_back({points[2].x, points[2].y});
+            break;
+        case PathCommand::Close:
+            command.path_verbs.push_back(PaintPathVerb::Close);
+            break;
+        }
+        iterator.next();
+    }
+
+    m_recorder->commands.emplace_back(std::move(command));
+}
+
 } // namespace lunasvg
