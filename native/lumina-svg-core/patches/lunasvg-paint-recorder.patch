+static bool isLegacyByteColorChannel(std::string_view value)
+{
+    value = trimmedValue(value);
+    if(value.empty() || value.size() > 3
+            || !std::all_of(value.begin(), value.end(), [](char character) {
+                return IS_NUM(character);
