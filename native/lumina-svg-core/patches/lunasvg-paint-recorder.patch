+
+PaintTransform recordingLocalTransform(
+    const SVGElement* element, const Transform& localTransform)
+{
+    const auto fallback = recordingTransformFrom(localTransform);
+    if(element == nullptr || !element->isGraphicsElement()
+            || !element->hasAttribute(PropertyID::Transform))
+        return fallback;
+    const auto* graphics = static_cast<const SVGGraphicsElement*>(element);
+    const auto floatExplicit = recordingTransformFrom(
+        graphics->transform().value());
+    PaintTransform inverseExplicit;
+    if(!inverseTransform(floatExplicit, inverseExplicit))
+        return fallback;
+    PaintTransform exactExplicit;
+    if(!parseExactTransform(
+            element->getAttribute(PropertyID::Transform), exactExplicit))
+        return fallback;
+    const auto remainder = composeRecordingTransforms(
+        inverseExplicit, fallback);
+    return composeRecordingTransforms(exactExplicit, remainder);
+}
