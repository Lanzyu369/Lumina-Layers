+PaintCommandList Document::recordPaintCommands() const
+{
+    PaintCommandList result;
+    result.bounds = boundingBox();
+    result.capability_issues = m_capabilityIssues;
+    if(!result.capability_issues.empty())
+        return result;
+
+    auto bounds = Rect(result.bounds);
+    auto canvas = Canvas::create(bounds);
+    SVGRenderState state(nullptr, nullptr, Transform::Identity,
+                         SVGRenderMode::Painting, canvas, &result);
+    rootElement(true)->render(state);
+    result.capability_issues = m_capabilityIssues;
+    if(!result.capability_issues.empty())
+        result.commands.clear();
+    return result;
+}
+
+int32_t Document::allocateSourceIndex()
+{
+    if(m_nextSourceIndex == std::numeric_limits<int32_t>::max()) {
+        addCapabilityIssue("numeric_range_error");
+        return -1;
+    }
+    return m_nextSourceIndex++;
+}
