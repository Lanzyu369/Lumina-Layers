+void SVGRenderState::recordPath(PaintCommandKind kind, const Path& path,
+                                FillRule fillRule,
+                                const StrokeData* strokeData,
+                                const SVGElement* sourceElement)
+{
+    if(!m_recorder || m_recordingSuppressed)
+        return;
+    auto source = sourceElement ? sourceElement : m_element;
+    if(!source)
+        return;
+    if(!m_canvas->hasSolidPaint()) {
+        recordCapabilityIssue("unsupported_paint_server", source);
+        return;
+    }
