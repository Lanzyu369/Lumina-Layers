+static bool hasPartialFunctionalColorAlpha(std::string_view value)
+{
+    const auto opening = value.find('(');
+    const auto closing = value.rfind(')');
+    if(opening == std::string_view::npos
+            || closing == std::string_view::npos || closing <= opening)
+        return false;
+    std::string functionName(trimmedValue(value.substr(0, opening)));
+    std::transform(
+        functionName.begin(), functionName.end(), functionName.begin(),
+        [](unsigned char character) {
+            return static_cast<char>(std::tolower(character));
+        });
+    if(functionName != "rgb" && functionName != "rgba"
+            && functionName != "hsl" && functionName != "hsla")
+        return false;
+    const auto parameters = value.substr(
+        opening + 1, closing - opening - 1);
+    size_t commaCount = 0;
+    size_t alphaStart = std::string_view::npos;
+    for(size_t index = 0; index < parameters.size(); ++index) {
+        if(parameters[index] != ',')
+            continue;
+        ++commaCount;
+        alphaStart = index + 1;
+    }
+    return commaCount == 3 && alphaStart != std::string_view::npos
+        && isPartialAlphaValue(parameters.substr(alphaStart), true);
