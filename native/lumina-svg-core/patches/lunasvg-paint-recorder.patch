+static bool plutovg_path_ensure_elements(plutovg_path_t* path, int count)
+{
+    if(path == NULL || path->allocation_failed || count < 0
+        || path->elements.size > INT_MAX - count) {
+        if(path != NULL)
+            path->allocation_failed = true;
+        return false;
+    }
+
+    const int required = path->elements.size + count;
+    if(required <= path->elements.capacity)
+        return true;
+    int newcapacity = path->elements.capacity == 0 ? 8 : path->elements.capacity;
+    while(newcapacity < required) {
+        if(newcapacity > INT_MAX / 2) {
+            newcapacity = required;
+            break;
+        }
+        newcapacity *= 2;
+    }
+    if((size_t)newcapacity > SIZE_MAX / sizeof(path->elements.data[0])) {
+        path->allocation_failed = true;
+        return false;
+    }
+    void* replacement = realloc(
+        path->elements.data,
+        (size_t)newcapacity * sizeof(path->elements.data[0]));
+    if(replacement == NULL) {
+        path->allocation_failed = true;
+        return false;
+    }
+    path->elements.data = replacement;
+    path->elements.capacity = newcapacity;
+    return true;
+}
