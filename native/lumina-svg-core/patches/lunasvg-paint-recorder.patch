+    rootElement(true)->transverse([this, &result](SVGElement* element) {
+        const auto& clipPath = element->getAttribute(PropertyID::Clip_Path);
+        if(!clipPath.empty() && clipPath != "none" && clipPath != "inherit"
+                && element->clipper() == nullptr)
+            result.capability_issues.emplace_back("unresolved_clip_path");
+        if(element->id() == ElementID::Use) {
+            auto useElement = static_cast<SVGUseElement*>(element);
+            if(useElement->getTargetElement(this) == nullptr)
+                result.capability_issues.emplace_back("unresolved_reference");
+        }
+    });
+    if(!result.capability_issues.empty())
+        return result;
+
+    result.bounds = boundingBox();
+    auto canvas = Canvas::createRecorder();
+    SVGRenderState state(nullptr, nullptr, Transform::Identity,
+                         SVGRenderMode::Painting, canvas, &result);
+    rootElement(true)->render(state);
+    result.capability_issues = m_capabilityIssues;
+    if(!result.capability_issues.empty())
+        result.commands.clear();
