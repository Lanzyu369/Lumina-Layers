+uint32_t saturatingIncrement(uint32_t value)
+{
+    return value == std::numeric_limits<uint32_t>::max()
+        ? value : value + 1;
+}
+
+uint32_t computeRelativePathOperationCount(std::string_view value)
+{
+    uint32_t count = 0;
+    char command = 0;
+    bool previousWasExponent = false;
+    for(size_t index = 0; index < value.size(); ++index) {
+        const char current = value[index];
+        if(std::isalpha(static_cast<unsigned char>(current))) {
+            if(current != 'e' && current != 'E')
+                command = current;
+            previousWasExponent = current == 'e' || current == 'E';
+            continue;
+        }
+        const bool numberStart = std::isdigit(static_cast<unsigned char>(current))
+            || current == '.'
+            || ((current == '+' || current == '-') && !previousWasExponent);
+        if(numberStart && command >= 'a' && command <= 'z')
+            count = saturatingIncrement(count);
+        previousWasExponent = false;
+        if(numberStart) {
+            while(index + 1 < value.size()) {
+                const char next = value[index + 1];
+                if(std::isdigit(static_cast<unsigned char>(next)) || next == '.') {
+                    ++index;
+                    continue;
+                }
+                if((next == 'e' || next == 'E') && index + 2 < value.size()) {
+                    ++index;
+                    if(value[index + 1] == '+' || value[index + 1] == '-')
+                        ++index;
+                    continue;
+                }
+                break;
+            }
+        }
+    }
+    return count;
+}
+
+uint32_t computeTransformOperationCount(std::string_view value)
+{
+    uint32_t count = 0;
+    for(size_t index = 0; index < value.size(); ++index) {
+        if(!std::isalpha(static_cast<unsigned char>(value[index])))
+            continue;
+        while(index + 1 < value.size()
+                && std::isalpha(static_cast<unsigned char>(value[index + 1])))
+            ++index;
+        size_t next = index + 1;
+        while(next < value.size()
+                && std::isspace(static_cast<unsigned char>(value[next])))
+            ++next;
+        if(next < value.size() && value[next] == '(')
+            count = saturatingIncrement(count);
+    }
+    return count;
+}
