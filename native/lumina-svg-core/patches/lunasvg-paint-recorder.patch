+bool SVGElement::setDeferredCapability(int specificity,
+                                       std::string_view propertyName,
+                                       std::string_view reason)
+{
+    if(!m_deferredCapabilities) {
+        m_deferredCapabilities = std::make_shared<DeferredCapabilityMap>();
+    } else if(m_deferredCapabilities.use_count() != 1) {
+        size_t retainedBytes = 0;
+        for(const auto& item : *m_deferredCapabilities) {
+            retainedBytes += sizeof(DeferredCapabilityMap::value_type)
+                + 64 + item.first.size() + item.second.reason.size();
+        }
+        if(!document()->consumeDeferredCapabilityStorage(
+                m_deferredCapabilities->size(), retainedBytes))
+            return false;
+        m_deferredCapabilities =
+            std::make_shared<DeferredCapabilityMap>(
+                *m_deferredCapabilities);
+    }
+
+    auto existing = m_deferredCapabilities->find(propertyName);
+    if(existing != m_deferredCapabilities->end()) {
+        if(specificity < existing->second.specificity)
+            return false;
+        if(reason.size() > existing->second.reason.size()
+                && !document()->consumeDeferredCapabilityStorage(
+                    0, reason.size() - existing->second.reason.size()))
+            return false;
+        existing->second.specificity = specificity;
+        existing->second.reason.assign(reason);
+        return true;
+    }
+
+    const size_t retainedBytes = sizeof(DeferredCapabilityMap::value_type)
+        + 64 + propertyName.size() + reason.size();
+    if(!document()->consumeDeferredCapabilityStorage(1, retainedBytes))
+        return false;
+    m_deferredCapabilities->emplace(
+        std::string(propertyName), DeferredCapability{specificity,
+                                                      std::string(reason)});
+    return true;
+}
