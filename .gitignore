# ==========================================
# electron 套壳:必要资源入库,中间产物排除
# ==========================================
# 上面 PyInstaller 的 build/ 规则会顺带把 electron/build/ 也屏蔽掉,
# 但 electron 的 build 里放的是 mac 图标资源和生成脚本,需要随仓库分发。
!electron/build/
!electron/build/**
# 但中间 iconset 目录不入库(每次跑脚本都会重新生成)
electron/build/icon.iconset/
electron/dist_electron/
electron/node_modules/

# ==========================================
# 本地参考工程(BambuStudio / OrcaSlicer / ChromaPrint3D 等),不入库
# ==========================================
reference-projects/

# macOS Finder metadata
.DS_Store


# MLS — write-password config is committed (default value). Treat the
# default as a deployment-time placeholder; rotate via env var
# ``MLS_WRITE_PASSWORD`` or by editing the file directly.
# MLS — 写入密码配置入库（默认值）。把默认值视作部署期占位，正式环境通过环境变量
# ``MLS_WRITE_PASSWORD`` 或直接修改文件来轮换。
