# Bug report email (v2.1). All optional; if unset, reports are
# logged + dumped to disk only.
#
# Resend SMTP relay example (sender can be a domain alias such as bugs@luminastudio.com.cn):
#   LUMINA_FEEDBACK_SMTP_HOST=smtp.resend.com
#   LUMINA_FEEDBACK_SMTP_PORT=587
#   LUMINA_FEEDBACK_SMTP_USER=resend
#   LUMINA_FEEDBACK_SMTP_PASSWORD=<resend-api-key>
#   LUMINA_FEEDBACK_SMTP_FROM=bugs@luminastudio.com.cn
#   LUMINA_FEEDBACK_TO=dev1@example.com,dev2@example.com
#   LUMINA_FEEDBACK_SMTP_USE_TLS=true
#
# Gmail example (sender == recipient is fine for self-host):
#   LUMINA_FEEDBACK_SMTP_HOST=smtp.gmail.com
#   LUMINA_FEEDBACK_SMTP_PORT=587
#   LUMINA_FEEDBACK_SMTP_USER=you@gmail.com
#   LUMINA_FEEDBACK_SMTP_PASSWORD=<16-char Google App Password>
#   LUMINA_FEEDBACK_SMTP_FROM=you@gmail.com
#   LUMINA_FEEDBACK_TO=you@gmail.com
#   LUMINA_FEEDBACK_SMTP_USE_TLS=true
#
# Gmail requires an App Password (regular Google Account password is
# blocked for SMTP since May 2022). Prerequisites:
#   1. Enable 2-Step Verification on the Google Account.
#   2. Generate a 16-character App Password at
#      https://myaccount.google.com/apppasswords
#   3. Paste the 16-char value (with or without spaces) into
#      LUMINA_FEEDBACK_SMTP_PASSWORD in your local .env.local.
LUMINA_FEEDBACK_SMTP_HOST=
LUMINA_FEEDBACK_SMTP_PORT=587
LUMINA_FEEDBACK_SMTP_USER=
LUMINA_FEEDBACK_SMTP_PASSWORD=
LUMINA_FEEDBACK_SMTP_FROM=
LUMINA_FEEDBACK_TO=
LUMINA_FEEDBACK_SMTP_USE_TLS=true
LUMINA_FEEDBACK_SMTP_TIMEOUT_S=5

# Bug report dump directory (default: <repo>/feedback)
LUMINA_FEEDBACK_DUMP_DIR=

# Bug report abuse guard. Set max <= 0 or window <= 0 only for trusted local testing.
LUMINA_FEEDBACK_RATE_LIMIT_MAX=30
LUMINA_FEEDBACK_RATE_LIMIT_WINDOW_S=300

# Optional hosted feedback relay. Leave empty unless you operate the official relay service.
# The token stays server-side and is never exposed to the browser.
LUMINA_FEEDBACK_RELAY_URL=
LUMINA_FEEDBACK_RELAY_TOKEN=
LUMINA_FEEDBACK_RELAY_TIMEOUT_S=8

# ─── Phase A4 — Server-side data plane (Postgres + Redis) ────────────
# Default LUMINA_BACKEND=memory keeps the desktop / single-user behavior:
# in-process state, restart drops everything. Switch to postgres for B2B
# Elegoo on-prem / B2C SaaS deployments after running:
#   docker compose up -d postgres redis
#   alembic -c api/migrations/alembic.ini upgrade head
# Phase A4 — 服务端数据面. 默认 memory 维持桌面行为; 切到 postgres
# 需要先起 docker-compose + 跑 alembic 迁移.
#
# A4-1 PR (current) ships only the scaffold; setting LUMINA_BACKEND=postgres
# raises NotImplementedError until A4-2 lands the actual session backend.
# 当前 PR 仅交付脚手架; 设为 postgres 会抛 NotImplementedError, 待 A4-2.
LUMINA_BACKEND=memory

# Postgres connection URL used by alembic + (later) PostgresSessionBackend.
# Required when LUMINA_BACKEND=postgres; ignored otherwise.
# Postgres 连接串, LUMINA_BACKEND=postgres 时必填, 其它情况忽略.
LUMINA_DATABASE_URL=
