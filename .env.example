# Frontend Umami analytics. Default is disabled; set these only when this
# Lumina instance should report to an existing central Umami deployment.
# 多实例共用同一个 Umami website 时，用 VITE_UMAMI_TAG 区分实例。
VITE_UMAMI_ENABLED=false
VITE_UMAMI_SCRIPT_URL=https://umami.example.com/script.js
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_HOST_URL=https://umami.example.com
VITE_UMAMI_TAG=local-dev
VITE_UMAMI_DOMAINS=
VITE_UMAMI_DO_NOT_TRACK=true
VITE_UMAMI_EXCLUDE_SEARCH=true
VITE_UMAMI_EXCLUDE_HASH=true
VITE_UMAMI_PERFORMANCE=false

# Bug report upload. Reports are saved locally, then uploaded to the official
# Lumina Studio feedback service with the collected diagnostics and files.
# No email or server credentials are needed on the client.
# Leave empty for the official service, set another base URL for a private
# feedback server, or set "off" to keep reports on this device only.
LUMINA_FEEDBACK_SERVER_URL=
LUMINA_FEEDBACK_SERVER_TIMEOUT_S=60

# Bug report dump directory (default: <repo>/feedback)
LUMINA_FEEDBACK_DUMP_DIR=

# Optional preview cache guardrails.
# Unset, empty, invalid, zero, or negative values disable these caps.
# These are diagnostic/constrained-machine escape hatches, not product defaults.
# LUMINA_PREVIEW_CACHE_MAX_BYTES=2147483648
# LUMINA_LARGE_FORMAT_SVG_PREVIEW_CACHE_MAX_BYTES=4294967296

# ─── Feedback / Bug-report subsystem (reproducible-bug-reports) ──────
# Two runtime settings for feedback packing and attachment cleanup.
# Accessors re-read os.environ; invalid or negative values log a WARNING
# and fall back to the default. Unset values use the default without a warning.
# 反馈打包和附件清理的两项配置。非法或负值记录警告并回退；未设置时使用默认值。

# LUMINA_FEEDBACK_MATERIALS_BUNDLE_TIMEOUT_S
# Optional timeout for packing the complete materials zip (seconds).
# Zero disables the timeout; a positive value enables it.
# 完整耗材档案的可选打包超时，单位为秒；0 表示不限制耗时。
# Default: 0
# LUMINA_FEEDBACK_MATERIALS_BUNDLE_TIMEOUT_S=0

# LUMINA_FEEDBACK_TICKET_TTL_DAYS
# Retention for bulky ticket attachments (days). Startup cleanup task drops
# original image / final artifact / LUT file / materials zip / screenshot
# older than this window.
# (工单大附件保留天数，启动时的清理任务会删除超出窗口的原图、最终产物、
# LUT 文件、耗材 zip 以及截图)
# Default: 30
# LUMINA_FEEDBACK_TICKET_TTL_DAYS=30

# ─── Material Registry / Sync ───────────────────────────────────────
# Optional read-only material Registry source for cloud/team material
# packages. Leave URL empty to disable manual and automatic refresh.
# Source installs do not include an official service URL or access credentials.
# Configure only a Registry you host or are authorized to use.
# 可选的只读耗材 Registry 来源，用于从云端/团队源拉取耗材包。
# URL 留空时，手动刷新和自动刷新都会不可用。
# 源码安装不附带官方服务地址或访问凭证；仅配置自建或已获授权的 Registry。
LUMINA_MATERIAL_REGISTRY_URL=
LUMINA_MATERIAL_REGISTRY_CHANNELS=official
LUMINA_MATERIAL_REGISTRY_TOKEN=
LUMINA_MATERIAL_REGISTRY_TIMEOUT_S=30

# Optional server-side automatic material sync. When
# LUMINA_MATERIAL_REGISTRY_URL is configured, startup refresh defaults to
# enabled and periodic refresh defaults to 21600 seconds (6 hours). Set these
# variables explicitly to override/disable that behavior.
# 配置 Registry URL 后默认启动刷新并每 6 小时同步一次；可显式覆盖或关闭。
LUMINA_MATERIAL_SYNC_STARTUP_REFRESH=
LUMINA_MATERIAL_SYNC_REFRESH_INTERVAL_S=

# Optional read-only Registry hosting settings for teams that serve material
# package ZIPs from this instance. Official channel is public; team/private
# packages require LUMINA_MATERIAL_REGISTRY_TEAM_TOKEN on read requests.
# 可选的 Registry 托管配置；official 频道公开读取，team/private 包需要 token。
LUMINA_MATERIAL_REGISTRY_PACKAGES_DIR=
LUMINA_MATERIAL_REGISTRY_TEAM_TOKEN=
LUMINA_MATERIAL_REGISTRY_OFFICIAL_PASSWORD=

# ─── Phase A4 — Server-side data plane (Postgres + Redis) ────────────
# Default LUMINA_BACKEND=memory keeps the desktop / single-user behavior:
# in-process state, restart drops everything. Switch to postgres for B2B
# Elegoo on-prem / B2C SaaS deployments after provisioning a PostgreSQL service
# and running:
#   alembic -c api/migrations/alembic.ini upgrade head
# Phase A4 — 服务端数据面. 默认 memory 维持桌面行为; 切到 postgres
# 需要先准备 PostgreSQL 服务并运行 alembic 迁移。
#
# The Postgres session and file backends are opt-in; the default stays memory.
# Postgres 会话及文件后端需要显式启用；默认仍为 memory。
LUMINA_BACKEND=memory

# Postgres connection URL used by alembic and PostgresSessionBackend.
# Required when LUMINA_BACKEND=postgres; ignored otherwise.
# Postgres 连接串, LUMINA_BACKEND=postgres 时必填, 其它情况忽略.
LUMINA_DATABASE_URL=
