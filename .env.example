# Bug report email (v2.1). All optional; if unset, reports are
# logged + dumped to disk only.
#
# Gmail example (sender == recipient is fine for self-host):
#   LUMINA_FEEDBACK_SMTP_HOST=smtp.gmail.com
#   LUMINA_FEEDBACK_SMTP_PORT=587
#   LUMINA_FEEDBACK_SMTP_USER=you@gmail.com
#   LUMINA_FEEDBACK_SMTP_PASSWORD=<16-char Google App Password>
#   LUMINA_FEEDBACK_SMTP_FROM=you@gmail.com
#   LUMINA_FEEDBACK_TO=you@gmail.com
#   LUMINA_FEEDBACK_SMTP_USE_TLS=true
#
# Gmail requires an App Password (regular Google Account password is
# blocked for SMTP since May 2022). Prerequisites:
#   1. Enable 2-Step Verification on the Google Account.
#   2. Generate a 16-character App Password at
#      https://myaccount.google.com/apppasswords
#   3. Paste the 16-char value (with or without spaces) into
#      LUMINA_FEEDBACK_SMTP_PASSWORD in your local .env.local.
LUMINA_FEEDBACK_SMTP_HOST=
LUMINA_FEEDBACK_SMTP_PORT=587
LUMINA_FEEDBACK_SMTP_USER=
LUMINA_FEEDBACK_SMTP_PASSWORD=
LUMINA_FEEDBACK_SMTP_FROM=
LUMINA_FEEDBACK_TO=
LUMINA_FEEDBACK_SMTP_USE_TLS=true
LUMINA_FEEDBACK_SMTP_TIMEOUT_S=5

# Bug report dump directory (default: <repo>/feedback)
LUMINA_FEEDBACK_DUMP_DIR=
